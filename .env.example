# .env.example
# Template defining required environment variables and API keys for VulnFlow.

# ==============================================================================
# 1. Primary LLM Provider Selection
# Options: nvidia (default), openrouter, openai, anthropic, ollama, bedrock
# ==============================================================================
VULNFLOW_LLM_PROVIDER=nvidia

# Global model override (applies across any provider if provider-specific model is not set)
# VULNFLOW_LLM_MODEL=minimaxai/minimax-m3.1-flash

# ==============================================================================
# 2. Provider API Keys & Configurable Models
# ==============================================================================

# NVIDIA NIM (Default recommended provider)
NVIDIA_API_KEY="nvapi-..."
# Configurable model for Nvidia NIM (e.g., nvidia/nemotron-3.5-lightning-30b-a3b)
# NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# OpenRouter (Access 100+ models via one unified key)
OPENROUTER_API_KEY="sk-or-v1-..."
# Configurable model for OpenRouter (e.g., meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-chat,
# anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001, qwen/qwen-2.5-coder-32b-instruct)
# OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# OpenAI
OPENAI_API_KEY="sk-..."
# Configurable model for OpenAI (e.g., gpt-4o, gpt-4o-mini, o3-mini)
# OPENAI_MODEL="gpt-4o"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."
# Configurable model for Anthropic (e.g., claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022)
# ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Ollama (Local LLMs)
# OLLAMA_MODEL="llama3.1"
# OLLAMA_BASE_URL="http://localhost:11434"

# AWS Bedrock
# BEDROCK_MODEL="anthropic.claude-3-5-sonnet-20241022-v2:0"
# AWS_ACCESS_KEY_ID="AKIA..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="us-east-1"

# ==============================================================================
# 3. Optional Per-Role Model Routing
# Route specific agent roles to customized models or providers
# ==============================================================================
# VULNFLOW_ROLE_MODEL_PLANNER="anthropic/claude-3.5-sonnet"
# VULNFLOW_ROLE_MODEL_TRIAGE="meta-llama/llama-3.1-8b-instruct"
# VULNFLOW_ROLE_MODEL_FIXER="anthropic/claude-3.5-sonnet"
# VULNFLOW_ROLE_MODEL_ROOTCAUSE="anthropic/claude-3.5-sonnet"
# VULNFLOW_ROLE_MODEL_VERIFIER="minimaxai/minimax-m3.1-flash"

# Graph/RAG run-level batch enrichment: zero calls for auto-tier plans, one call
# per review-plan batch, with one split on invalid structured output and cache reuse.
VULNFLOW_PLANNER_LLM_ENRICHMENT="selective"
VULNFLOW_BATCH_ENRICHMENT_MAX_PLANS=20
VULNFLOW_POLICY_VERSION="default"
# Enable only after replacing the built-in demo graph with organization data.
VULNFLOW_ORGANIZATION_GRAPH_ENABLED=false

# ==============================================================================
# 4. Tracing & Observability (LangSmith)
# ==============================================================================
# LANGSMITH_API_KEY="lsv2_pt_..."
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT="vulnflow"

# ==============================================================================
# 5. Durable Approval & Workflow State (Supabase)
# Apply all SQL files in supabase/migrations in filename order before enabling.
# Keep the secret key in trusted backend and CI environments only.
# ==============================================================================
SUPABASE_URL="https://iozaqfqmyyhqfggiimcm.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_your-backend-key"
VULNFLOW_ORG_SLUG="your-organization"
VULNFLOW_REPOSITORY="your-organization/your-repository"
# Comma-separated groups; every listed group must approve before execution resumes.
VULNFLOW_APPROVER_GROUPS="security,product-owner,vp"
# Fail instead of falling back to local files when Supabase is unavailable.
VULNFLOW_SUPABASE_REQUIRED=true

# ==============================================================================
# 6. Git & Issue Integrations
# ==============================================================================
# GitHub Personal Access Token (Required for real PR opening; needs 'repo' scope)
GITHUB_TOKEN="ghp_..."

# Optional Jira Configuration (For enterprise exception ticketing)
JIRA_URL="https://your-domain.atlassian.net"
JIRA_USERNAME="security-service-account@company.com"
JIRA_API_TOKEN="..."

# ==============================================================================
# 7. Verification and HTTP control plane
# ==============================================================================
# Trusted, preloaded Docker image containing the target ecosystem's tools.
# VULNFLOW_BUILD_SANDBOX_IMAGE=
# VULNFLOW_API_TOKEN=
# VULNFLOW_WEBHOOK_SECRET=
# VULNFLOW_ALLOWED_REPO_ROOTS=
# VULNFLOW_CORS_ORIGINS=
# VULNFLOW_API_MAX_INFLIGHT=8
