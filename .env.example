# .env.example
# Template defining required environment variables and API keys for VulnFlow.

# LLM Provider selection: nvidia (default), openrouter, openai, anthropic, ollama, or bedrock
VULNFLOW_LLM_PROVIDER=nvidia

# NVIDIA NIM API Key (Default recommended provider)
NVIDIA_API_KEY="nvapi-..."

# Alternative LLM Provider API Keys (if not using nvidia)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# GitHub Personal Access Token (Required for real PR opening and @modelcontextprotocol/server-github)
# Needs 'repo' scope on target repositories
GITHUB_TOKEN="ghp_..."

# Optional Jira Configuration (For enterprise exception ticketing)
JIRA_URL="https://your-domain.atlassian.net"
JIRA_USERNAME="security-service-account@company.com"
JIRA_API_TOKEN="..."
