# .gitignore
# Specifies untracked and generated files to ignore in the Git repository.

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/

# VulnFlow runtime artifacts and audit logs
.vulnflow/

# Build and distribution
build/
dist/
*.egg-info/
.eggs/

# Node & package manager artifacts
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
.env
.env.local

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
